    // Affichage des erreurs a l'ecran. TOUJOURS false en production.
    'debug'    => true,

    'db' => [
        // Nom du service MariaDB sur le reseau Docker.
        // JAMAIS 'localhost' : depuis le conteneur PHP, la base est
        // une autre machine.
        'host' => 'mariadb',
        'port' => 3306,
        'name' => 'mickey_tournois_dev',
        'user' => 'tournois',
        'pass' => 'A_REMPLACER',
    ],

    // Base dediee au module -> pas de prefixe de tables.
    'prefix' => '',
